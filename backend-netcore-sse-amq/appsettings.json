{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionTimeouts": {
    "SSETimeoutMinutes": 30,
    "MaxIdleTimeMinutes": 15,
    "MaxConnectionTimeHours": 2,
    "HeartbeatIntervalMinutes": 5,
    "TimeoutCheckIntervalMinutes": 2
  },
  "Kestrel": {
    "Limits": {
      "KeepAliveTimeoutMinutes": 10,
      "RequestHeadersTimeoutSeconds": 30,
      "MaxConcurrentConnections": 1000
    }
  }
}
